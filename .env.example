# Never commit real secrets.

# Scene generation provider chain.
# Cloudflare is the low-cost/free-allocation default.
IMAGE_PROVIDER_ORDER=cloudflare,pollinations,openai

# Cloudflare Workers AI
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
CLOUDFLARE_IMAGE_STEPS=4
CLOUDFLARE_SCENE_REFERENCE_MODEL=@cf/black-forest-labs/flux-2-klein-4b

# Optional experimental fallback. Keep server-side only.
POLLINATIONS_API_KEY=
POLLINATIONS_IMAGE_MODEL=flux

# OpenAI is optional and is the last fallback by default.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.6-luna
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
OPENAI_VISION_MODEL=gpt-5.6-luna
OPENAI_IMAGE_QUALITY=medium

# Commercial beta controls.
# 0 disables a limit. These counters are in-memory beta guards, not billing entitlements.
FREE_SCENE_GENERATIONS_PER_DAY=3
SCENE_GLOBAL_DAILY_LIMIT=120
BETA_CREATOR_PRICE_BRL=29
BETA_CHECKOUT_URL=
BETA_WAITLIST_URL=

# Recommended while sharing a restricted Studio test URL.
# The landing page remains public even when Studio auth is enabled.
STUDIO_BASIC_USER=designer
STUDIO_BASIC_PASS=
AI_RATE_LIMIT_PER_HOUR=60

# Railway provides PORT automatically. This is the local default.
PORT=8000
